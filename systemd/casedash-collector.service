[Unit]
Description=Case-screen telemetry collector (writes one JSON state blob)
Documentation=file://%h/projects/casedash/README.md
After=graphical-session.target

[Service]
Type=simple
# The collector needs no display at all -- it only reads /proc, /sys, nvidia-smi,
# apcaccess, fastfetch and wttr.in. That is the whole point of splitting it from
# the renderer: no graphical dependency, so no update can strand it.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# --- configuration (see the README's Configuration table) ---
# Interface to graph. Find yours with: ip route get 1.1.1.1
Environment=CASEDASH_NET_IFACE=enp77s0
# wttr.in location, as "lat,lon" (a place name also works, but it is re-geocoded
# on every resolve and that lookup is what once put this panel in Argentina).
# Do NOT use "auto": wttr.in has no such slug and silently falls back to
# IP geolocation. See the README's "Do not leave the weather location on auto".
Environment=CASEDASH_WX_LOCATION=34.746,-92.289
# %h expands to the invoking user's home, so this unit is not tied to one account.
ExecStart=/usr/bin/python3 %h/projects/casedash/collector/casedash_collector.py
Restart=always
RestartSec=3
# If it wedges (a hung probe), kill and restart rather than silently freezing
# the panel on stale numbers.
WatchdogSec=0
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
# Keep it off the game's cores and away from the GPU entirely.
CPUWeight=20
IOWeight=20
MemoryMax=256M

[Install]
WantedBy=default.target
