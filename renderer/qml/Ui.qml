// Ui.qml -- layout and type metrics for the case screen dashboard.
//
// WHY THIS FILE EXISTS (and is separate from Theme.qml):
// Theme.qml is GENERATED by theme/casedash-theme.py on every `theme apply`, so
// any hand-edited metric in it gets wiped by a colour change. Type sizes are not
// theme data; they belong in a file a theming run will never touch.
//
// HOW TO MAKE THE TEXT BIGGER:
// Change `scale` below. Everything -- fonts, card padding, row pitch, gauge
// sizes -- is derived from it. Nothing else needs editing.
//
// Why a scale factor instead of bigger hardcoded numbers: the panel is
// 1100x3840 and every size in the original QML was tuned by hand against a real
// capture. Scaling from one number keeps those tuned PROPORTIONS intact, so the
// layout still looks the same, only larger. Editing 60-odd literals by hand
// would drift the design.
//
// The base sizes here are the ORIGINAL values (scale 1.0 == the panel exactly as
// first shipped), so this file is a faithful record of the tuning, not a rewrite.
import QtQuick
pragma Singleton

QtObject {
    id: ui

    // ------------------------------------------------------------------ scale
    // 1.55 was chosen against a real capture: base label text rendered at 11px
    // cap height on a 3840px-tall panel, which is unreadable at desk distance.
    // 1.55 -> ~17px. Do not push much past ~1.7: the panel has ~1100px of slack
    // that the two Layout.fillHeight cards absorb, and beyond that the STORAGE
    // and SYSTEM cards start eliding their value column.
    readonly property real scale: 1.55

    // ------------------------------------------------------------------- fonts
    // Base pixel sizes, matching the original hand-tuned values at scale 1.0.
    readonly property int fsClock:     Math.round(118 * scale)
    readonly property int fsDate:      Math.round(30  * scale)
    readonly property int fsWxGlyph:   Math.round(40  * scale)
    readonly property int fsWxTemp:    Math.round(38  * scale)
    readonly property int fsWxDesc:    Math.round(22  * scale)
    readonly property int fsCardTitle: Math.round(13  * scale)
    readonly property int fsCardRight: Math.round(14  * scale)
    readonly property int fsStale:     Math.round(14  * scale)

    // KeyValue rows: the small text that was hardest to read. This is the pair
    // that matters most; most of the panel's text goes through KeyValue.
    readonly property int fsLabel: Math.round(15 * scale)
    readonly property int fsValue: Math.round(15 * scale)

    // ---------------------------------------------------------------- geometry
    // Vertical rhythm scales so the extra text height has somewhere to go
    // instead of overlapping the next row.
    readonly property real margin:     Math.round(30 * scale)
    readonly property real colSpacing: Math.round(18 * scale)

    // Card chrome.
    readonly property real cardPad:      Math.round(14 * scale)
    readonly property real cardHeadH:    Math.round(22 * scale)
    readonly property real cardHeadGap:  Math.round(8  * scale)
    readonly property real cardPadTop:   Math.round(14 * scale)
    readonly property real cardPadBot:   Math.round(12 * scale)
    readonly property real cardRadius:   Math.round(10 * scale)
    readonly property real pipW:         Math.round(4  * scale)
    readonly property real pipH:         Math.round(14 * scale)

    // KeyValue row internals.
    readonly property real kvGap:       Math.round(12 * scale)
    readonly property real kvPad:       Math.round(2  * scale)
    readonly property real kvLabelFrac: 0.45   // label column = min(labelWidth, width*this)

    // Gauges.
    // Deliberately a GENTLER multiplier than `scale`. Two gauges side by side
    // plus the VRAM/RAM/POWER value stack have to fit inside 1100px, and at the
    // full text scale the gauges starved the value column until "10363 / 24564
    // MB" elided. The gauges were never the readability problem -- the small
    // text was -- so they grow less and hand the width back to the text.
    readonly property real gaugeScale: 1.18
    readonly property real gaugeSize: Math.round(186 * gaugeScale)

    // Per-core bars.
    readonly property real coreBarLabelH: Math.round(14 * scale)
    readonly property real coreBarMinW:   Math.round(4  * scale)

    // Progress bars.
    readonly property real barH:       Math.round(10 * scale)
    readonly property real barHThin:   Math.round(6  * scale)

    // ------------------------------------------------------------------ helpers
    // For one-off sizes that do not warrant their own named property.
    function s(v) { return Math.round(v * scale) }
    // Card implicit height: content plus the scaled chrome.
    function cardChrome() {
        return cardPadTop + cardHeadH + cardHeadGap + cardPadBot
    }

    // ------------------------------------------------------- vertical budget
    // The panel is a fixed 3840px tall and the section ColumnLayout does not
    // scroll. If the sum of the section heights exceeds the content box, QML
    // does not clip or shrink -- it lets adjacent cards OVERLAP, and the last
    // card's content slides under the next one. That is not obvious from the
    // source, and it is exactly how the CPU sparkline ended up rendering behind
    // the GPU card when `scale` was raised.
    //
    // HOW THE FIT ACTUALLY WORKS (measured, not assumed):
    //   The three Layout.fillHeight cards do NOT use their preferredHeight as a
    //   final height -- they ABSORB the leftover after the fixed sections and
    //   the gaps. Measured at scale 1.55: CPU 536, GPU 509, NET 675, all well
    //   above their hints. So `preferredHeight` on those cards is a floor for
    //   the initial pass, not a size.
    //
    //   That means the thing that must fit is the FIXED sum. The fillHeight
    //   hints only matter as a lower bound: if the fixed sum plus the hints
    //   exceeds the content box, there is no leftover and the cards get their
    //   (too large) hints instead, which is when the overlap starts.
    //
    // Both conditions are checked in layoutBudget() below.
    readonly property int panelHeight: 3840
    readonly property int sectionCount: 9   // 8 cards/blocks + trailing spacer

    // A KeyValue row's real height, MEASURED rather than guessed. Noto Sans at
    // fsValue renders an implicitHeight of 32px at scale 1.55 (1.39 * pixelSize)
    // plus kvPad. Deriving it here means a card's height is computed from the
    // text it actually contains -- an earlier hand-guessed SYSTEM height was
    // 22px short and silently clipped the DISPLAYS row in half.
    readonly property real kvRowH: (Math.round(fsValue * 1.39)) + kvPad

    // Fixed (non-fillHeight) sections, in base units.
    // The header block (clock + date + weather) sizes itself to its content via
    // implicitHeight; the measured value at scale 1.55 is 417px = 269 base
    // units. Keep this in sync if the clock font or weather line changes.
    readonly property int hHeaderMeasured: 269
    // Gap inserted between the date and the weather line. The two used to be
    // flush, which read as cramped; this is the only knob for that spacing.
    readonly property real headerWxGap: 22
    readonly property int hGaugeRow:    300
    readonly property int hUps:         105   // 2 rows + 1 bar + chrome
    // SYSTEM: 8 rows, derived from kvRowH so it cannot drift from the text.
    // 8 rows + 7 gaps of s(2) + card chrome = 388px at scale 1.55 = 251 units.
    readonly property int hSystemRows: 8
    readonly property int hSystem: 251
    readonly property int hStorageBase:  50   // + hStoragePerDisk * diskCount
    readonly property int hStoragePerDisk: 84
    readonly property int hSpacer:       20

    // Layout.fillHeight sections. These absorb the leftover, so these are
    // LOWER BOUNDS, not sizes. Measured actual heights at 1.55 were CPU 536,
    // GPU 509, NET 675 -- the network card was the largest on the panel while
    // being the least important, which is why its hint is now the smallest of
    // the three and its sparkline fills rather than holding a fixed height.
    readonly property int hCpuCard: 210
    readonly property int hGpuCard: 200
    readonly property int hNetCard: 200

    // Height a KeyValue-stack card needs for `rows` rows.
    function rowsCardH(rows) {
        return cardChrome()
             + rows * kvRowH
             + Math.max(0, rows - 1) * s(2)
    }

    // Does the layout fit? Returns the arithmetic so a failure is diagnosable.
    function layoutBudget(diskCount) {
        var fixed = s(hHeaderMeasured) + s(hGaugeRow) + s(hUps)
                  + s(hStorageBase) + s(hStoragePerDisk) * Math.max(1, diskCount)
                  + s(hSystem) + s(hSpacer)
        var hints = s(hCpuCard) + s(hGpuCard) + s(hNetCard)
        var gaps = colSpacing * (sectionCount - 1)
        var content = panelHeight - 2 * margin
        var leftover = content - fixed - gaps
        var needed = fixed + hints + gaps
        return {
            "fixed": fixed,
            "hints": hints,
            "gaps": gaps,
            "content": content,
            // Space the fillHeight cards actually share, after fixed + gaps.
            "leftover": leftover,
            // Demand if the hints were honoured literally (the worst case, and
            // the condition that causes overlap when it exceeds `content`).
            "needed": needed,
            "slack": content - needed,
            "fits": needed <= content && leftover > 0,
            // Per-card share when the leftover is distributed evenly.
            "perFillCard": Math.floor(leftover / 3)
        }
    }
}
